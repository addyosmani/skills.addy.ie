---
interface Props {
  command: string;
  prompt?: string;
  size?: 'sm' | 'md' | 'lg';
  label?: string;
}
const { command, prompt = '$', size = 'md', label } = Astro.props;
---

<div class:list={['cmd', `cmd-${size}`]} data-copy-root>
  {label && <span class="cmd-label">{label}</span>}
  <div class="cmd-body">
    <span class="cmd-prompt" aria-hidden="true">{prompt}</span>
    <code class="cmd-text" data-copy-text>{command}</code>
    <button class="cmd-btn" data-copy-btn aria-label={`Copy: ${command}`}>
      <svg class="i-copy" viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
        <rect x="5.5" y="5.5" width="8" height="8" rx="1.6" stroke="currentColor" stroke-width="1.3"/>
        <path d="M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5" stroke="currentColor" stroke-width="1.3"/>
      </svg>
      <svg class="i-check" viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
        <path d="M3.5 8.5l3 3 6-6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</div>

<style>
  .cmd {
    display: inline-flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    max-width: 100%;
  }
  .cmd-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .cmd-body {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    padding: 0 8px 0 16px;
    font-family: var(--font-mono);
    transition: border-color 0.2s var(--ease);
    overflow: hidden;
  }
  .cmd-body:hover {
    border-color: var(--border-hover);
  }
  .cmd-prompt {
    color: var(--accent);
    user-select: none;
    flex: none;
  }
  .cmd-text {
    color: var(--fg);
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
    flex: 1;
    padding-block: 14px;
  }
  .cmd-text::-webkit-scrollbar {
    display: none;
  }
  .cmd-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--r-sm);
    background: transparent;
    border: 1px solid transparent;
    color: var(--fg-dim);
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }
  .cmd-btn:hover {
    color: var(--fg-bright);
    background: var(--surface-3);
    border-color: var(--border);
  }
  .i-check {
    display: none;
    color: var(--success);
  }
  .cmd-btn.copied .i-copy {
    display: none;
  }
  .cmd-btn.copied .i-check {
    display: block;
  }

  .cmd-sm .cmd-body {
    padding-left: 12px;
    font-size: 0.82rem;
  }
  .cmd-sm .cmd-text {
    padding-block: 10px;
  }
  .cmd-lg .cmd-body {
    font-size: 1rem;
    padding-left: 18px;
  }
  .cmd-lg .cmd-text {
    padding-block: 17px;
  }
</style>

<script>
  document.querySelectorAll('[data-copy-root]').forEach((root) => {
    const btn = root.querySelector('[data-copy-btn]');
    const text = root.querySelector('[data-copy-text]')?.textContent ?? '';
    btn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      btn.classList.add('copied');
      setTimeout(() => btn.classList.remove('copied'), 1600);
    });
  });
</script>
