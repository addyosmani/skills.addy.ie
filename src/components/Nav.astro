---
import { REPO_URL } from '../data/skills';
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
const links = [
  { href: '/skills', label: 'Skills' },
  { href: '/docs/getting-started', label: 'Docs' },
  { href: '/lifecycle', label: 'Lifecycle' },
  { href: '/compare', label: 'Compare' },
];
---

<header class="nav">
  <div class="nav-inner container">
    <a href="/" class="brand" aria-label="agent-skills home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" width="22" height="22">
          <path d="M4 7.5 12 3l8 4.5v9L12 21l-8-4.5v-9Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          <path d="M12 3v18M4 7.5l8 4.5 8-4.5" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" opacity="0.55"/>
        </svg>
      </span>
      <span class="brand-name">agent<span class="brand-dim">-skills</span></span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class:list={['nav-link', { active: isActive(l.href) }]}>
          {l.label}
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href={REPO_URL} class="nav-github" target="_blank" rel="noopener" aria-label="GitHub repository">
        <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
        </svg>
      </a>
      <a href="/docs/getting-started" class="btn btn-primary nav-cta">Get started</a>
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" data-nav-toggle>
        <span></span><span></span>
      </button>
    </div>
  </div>
  <nav class="nav-mobile" aria-label="Mobile" data-nav-mobile>
    {links.map((l) => <a href={l.href} class="nav-mobile-link">{l.label}</a>)}
    <a href={REPO_URL} class="nav-mobile-link" target="_blank" rel="noopener">GitHub ↗</a>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--nav-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 0.98rem;
    color: var(--fg-bright);
  }
  .brand-mark {
    color: var(--accent);
    display: inline-flex;
  }
  .brand-dim {
    color: var(--fg-dim);
  }
  .nav-links {
    display: flex;
    gap: 4px;
    margin-inline-start: 8px;
  }
  .nav-link {
    padding: 7px 12px;
    font-size: 0.9rem;
    color: var(--fg-muted);
    border-radius: var(--r-sm);
    transition: color 0.15s, background 0.15s;
  }
  .nav-link:hover {
    color: var(--fg-bright);
    background: var(--surface-2);
  }
  .nav-link.active {
    color: var(--fg-bright);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-inline-start: auto;
  }
  .nav-github {
    display: inline-flex;
    padding: 8px;
    color: var(--fg-muted);
    border-radius: var(--r-sm);
    transition: color 0.15s, background 0.15s;
  }
  .nav-github:hover {
    color: var(--fg-bright);
    background: var(--surface-2);
  }
  .nav-cta {
    height: 36px;
    padding-inline: 15px;
    font-size: 0.88rem;
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    padding: 8px;
  }
  .nav-toggle span {
    width: 20px;
    height: 1.5px;
    background: var(--fg);
    transition: transform 0.2s, opacity 0.2s;
  }
  .nav-mobile {
    display: none;
    flex-direction: column;
    padding: 8px 24px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  .nav-mobile.open {
    display: flex;
  }
  .nav-mobile-link {
    padding: 12px 4px;
    color: var(--fg-muted);
    border-bottom: 1px solid var(--border);
    font-size: 0.98rem;
  }
  .nav-mobile-link:hover {
    color: var(--fg-bright);
  }

  @media (max-width: 780px) {
    .nav-links,
    .nav-cta {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const mobile = document.querySelector('[data-nav-mobile]');
  toggle?.addEventListener('click', () => {
    const open = mobile?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
</script>
