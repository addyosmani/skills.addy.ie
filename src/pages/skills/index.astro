---
import Base from '../../layouts/Base.astro';
import SkillCard from '../../components/SkillCard.astro';
import CopyCommand from '../../components/CopyCommand.astro';
import { skills, phases, totalSkills, INSTALL_CMD } from '../../data/skills';

const filterPhases = phases; // includes meta
---

<Base
  title="Skills catalog - agent-skills"
  description={`Browse all ${totalSkills} agent skills by lifecycle phase. Search, filter, and copy the install command for each structured engineering workflow.`}
>
  <section class="skills-hero">
    <div class="grid-bg"></div>
    <div class="container skills-hero-inner">
      <span class="eyebrow">The catalog</span>
      <h1 class="skills-h1">{totalSkills} skills, one per job</h1>
      <p class="skills-lede">
        Each skill is a structured workflow - steps, verification gates, and
        anti-rationalization tables - not a loose prompt. Filter by phase or search
        by what you’re doing.
      </p>
      <div class="skills-hero-cmd">
        <CopyCommand command={INSTALL_CMD} />
      </div>
    </div>
  </section>

  <section class="container skills-body">
    <div class="skills-toolbar">
      <div class="search-wrap">
        <svg class="search-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.4"/>
          <path d="m11 11 3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        <input
          type="search"
          id="skill-search"
          placeholder="Search skills - try “tests”, “security”, “api”…"
          autocomplete="off"
          aria-label="Search skills"
        />
        <kbd class="search-kbd">/</kbd>
      </div>
      <div class="filters" role="tablist" aria-label="Filter by phase">
        <button class="filter active" data-filter="all" role="tab" aria-selected="true">
          All <span class="filter-count">{totalSkills}</span>
        </button>
        {filterPhases.map((p) => (
          <button class="filter" data-filter={p.id} style={`--h:${p.hue}`} role="tab" aria-selected="false">
            <span class="phase-dot"></span>{p.label}
            <span class="filter-count">{skills.filter((s) => s.phase === p.id).length}</span>
          </button>
        ))}
      </div>
    </div>

    <p class="results-count" id="results-count" aria-live="polite"></p>

    <div class="skills-grid" id="skills-grid">
      {skills.map((s) => <SkillCard skill={s} />)}
    </div>

    <div class="no-results" id="no-results" hidden>
      <p>No skills match that search.</p>
      <button class="btn btn-secondary" id="clear-search">Clear</button>
    </div>
  </section>
</Base>

<style>
  .skills-hero {
    position: relative;
    padding-block: clamp(48px, 8vw, 84px) 32px;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .skills-hero-inner {
    position: relative;
    max-width: 680px;
  }
  .skills-h1 {
    margin-top: 16px;
    font-size: clamp(2rem, 5vw, 3.1rem);
    letter-spacing: -0.03em;
  }
  .skills-lede {
    margin-top: 16px;
    color: var(--fg-muted);
    font-size: clamp(1rem, 1.6vw, 1.12rem);
    line-height: 1.6;
  }
  .skills-hero-cmd {
    margin-top: 26px;
    max-width: 420px;
  }

  .skills-body {
    padding-block: 32px 96px;
  }
  .skills-toolbar {
    position: sticky;
    top: var(--nav-h);
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-block: 20px;
    margin-bottom: 8px;
    background: linear-gradient(to bottom, var(--bg) 78%, transparent);
  }
  .search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-icon {
    position: absolute;
    left: 15px;
    color: var(--fg-dim);
    pointer-events: none;
  }
  #skill-search {
    width: 100%;
    height: 46px;
    padding: 0 44px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    color: var(--fg);
    font-size: 0.96rem;
    font-family: inherit;
    transition: border-color 0.2s, background 0.2s;
  }
  #skill-search::placeholder {
    color: var(--fg-faint);
  }
  #skill-search:focus {
    outline: none;
    border-color: var(--border-hover);
    background: var(--surface-2);
  }
  .search-kbd {
    position: absolute;
    right: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    border: 1px solid var(--border-strong);
    background: var(--surface-2);
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 34px;
    padding-inline: 13px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--fg-muted);
    font-size: 0.85rem;
    transition: all 0.15s var(--ease);
  }
  .filter:hover {
    border-color: var(--border-hover);
    color: var(--fg-bright);
  }
  .filter.active {
    background: var(--fg-bright);
    color: #000;
    border-color: var(--fg-bright);
  }
  .filter.active .filter-count {
    color: rgba(0, 0, 0, 0.5);
  }
  .filter.active .phase-dot {
    background: #000;
    box-shadow: none;
  }
  .filter-count {
    color: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .results-count {
    color: var(--fg-faint);
    font-size: 0.82rem;
    font-family: var(--font-mono);
    margin-bottom: 18px;
    min-height: 1em;
  }
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .skills-grid :global(.skill-card.hidden) {
    display: none;
  }
  .no-results {
    text-align: center;
    padding: 64px 0;
    color: var(--fg-muted);
  }
  .no-results p {
    margin-bottom: 16px;
  }

  @media (max-width: 860px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const search = document.getElementById('skill-search') as HTMLInputElement;
  const filters = Array.from(document.querySelectorAll('.filter')) as HTMLButtonElement[];
  const cards = Array.from(document.querySelectorAll('.skill-card')) as HTMLElement[];
  const grid = document.getElementById('skills-grid')!;
  const countEl = document.getElementById('results-count')!;
  const noResults = document.getElementById('no-results')!;
  const clearBtn = document.getElementById('clear-search');

  let activeFilter = 'all';

  function apply() {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const matchPhase = activeFilter === 'all' || card.dataset.phase === activeFilter;
      const matchSearch = !q || (card.dataset.search ?? '').includes(q);
      const visible = matchPhase && matchSearch;
      card.classList.toggle('hidden', !visible);
      if (visible) shown++;
    }
    countEl.textContent = shown === cards.length
      ? `${shown} skills`
      : `${shown} of ${cards.length} skills`;
    noResults.hidden = shown !== 0;
    grid.style.display = shown === 0 ? 'none' : '';
  }

  search.addEventListener('input', apply);
  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      filters.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      activeFilter = btn.dataset.filter ?? 'all';
      apply();
    });
  });
  clearBtn?.addEventListener('click', () => {
    search.value = '';
    apply();
    search.focus();
  });

  // Keyboard: "/" focuses search
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== search) {
      e.preventDefault();
      search.focus();
    }
    if (e.key === 'Escape' && document.activeElement === search) {
      search.value = '';
      apply();
      search.blur();
    }
  });

  apply();
</script>
